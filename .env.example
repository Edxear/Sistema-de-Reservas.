# ─────────────────────────────────────────────
# REQUERIDAS — el servidor no arranca sin estas
# ─────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio
FRONTEND_URL=http://localhost:3000

# ─────────────────────────────────────────────
# Servidor
# ─────────────────────────────────────────────
PORT=5000
NODE_ENV=development
BACKEND_URL=http://localhost:5000

# ─────────────────────────────────────────────
# Email (SMTP) — opcional. Si no se configura el envío de correos queda desactivado.
# ─────────────────────────────────────────────
EMAIL_ENABLED=true
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=tu_correo@gmail.com
EMAIL_PASS=tu_app_password_de_gmail
EMAIL_FROM=tu_correo@gmail.com

# ─────────────────────────────────────────────
# Mercado Pago — opcional. Necesario para pagos en línea.
# ─────────────────────────────────────────────
MERCADOPAGO_ACCESS_TOKEN=

# ─────────────────────────────────────────────
# Seeds / scripts de inicialización — opcional
# ─────────────────────────────────────────────
SEED_INITIAL_PASSWORD=clinica123
SEED_SUPERADMIN_PASSWORD=Admin1234
SUPERADMIN_EMAIL=admin.principal@integraSalud.com
SUPERADMIN_NOMBRE=Administrador Principal
SUPERADMIN_TELEFONO=3415000000

# Contraseña por defecto para usuarios creados internamente (médicos/pacientes gestionados)
DEFAULT_MANAGED_USER_PASSWORD=clinica123
